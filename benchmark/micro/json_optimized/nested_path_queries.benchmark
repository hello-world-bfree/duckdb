name JSON Deep Nested Extraction - 100K rows
group json_optimized

require json

load
CREATE TABLE events_100k AS
SELECT row_number() OVER () as row_id, json_col::JSON as json_col
FROM read_json('benchmark/micro/json_optimized/data/nested_100k.jsonl', columns={json_col: 'JSON'});

run
SELECT
    json_col->'profile'->'contact'->'address'->>'street' as street,
    json_col->'profile'->'contact'->'address'->>'city' as city,
    json_col->'profile'->'contact'->'address'->>'zipcode' as zipcode,
    json_col->'activity'->'last_login'->>'timestamp' as last_login
FROM events_100k;

cleanup
DROP TABLE events_100k;
