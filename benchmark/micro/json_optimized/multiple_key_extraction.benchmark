name JSON Multiple Key Extraction (6 keys) - 10K rows
group json_optimized

require json

load
CREATE TABLE events_10k AS
SELECT row_number() OVER () as row_id, json_col::JSON as json_col
FROM read_json('benchmark/micro/json_optimized/data/consistent_10k.jsonl', columns={json_col: 'JSON'});

run
SELECT
    json_col->>'user_id' as user_id,
    json_col->>'email' as email,
    json_col->>'age' as age,
    json_col->>'status' as status,
    json_col->>'score' as score,
    json_col->'metadata'->>'timestamp' as timestamp
FROM events_10k;

cleanup
DROP TABLE events_10k;

