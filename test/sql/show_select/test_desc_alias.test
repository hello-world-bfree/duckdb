# name: test/sql/show_select/test_desc_alias.test
# description: Test DESC as an alias for DESCRIBE
# group: [show_select]

statement ok
PRAGMA enable_verification

statement ok
CREATE TABLE test_table(id INTEGER PRIMARY KEY, name VARCHAR, value DOUBLE);

# Test DESC with table name
query TTTTTT
DESC test_table
----
id	INTEGER	NO	PRI	NULL	NULL
name	VARCHAR	YES		NULL	NULL
value	DOUBLE	YES		NULL	NULL

# Verify DESCRIBE produces the same result
query TTTTTT
DESCRIBE test_table
----
id	INTEGER	NO	PRI	NULL	NULL
name	VARCHAR	YES		NULL	NULL
value	DOUBLE	YES		NULL	NULL

# Test DESC with SELECT statement
query TTTTTT
DESC SELECT 42 AS answer, 'hello' AS greeting
----
answer	INTEGER	YES		NULL	NULL
greeting	VARCHAR	YES		NULL	NULL

# Test DESC in subquery
query I
SELECT column_name FROM (DESC SELECT 1 AS a, 2 AS b)
----
a
b

# Test DESC with qualified table name
statement ok
CREATE SCHEMA test_schema;

statement ok
CREATE TABLE test_schema.another_table(x INTEGER, y VARCHAR);

query TTTTTT
DESC test_schema.another_table
----
x	INTEGER	YES		NULL	NULL
y	VARCHAR	YES		NULL	NULL

# Test DESC TABLES FROM
statement ok
CREATE DATABASE test_db;

statement ok
CREATE TABLE test_db.main.db_table(col1 INTEGER);

query I nosort
SELECT table_name FROM (DESC TABLES FROM test_db)
----
db_table

# Test DESC with nested DESCRIBE
query I
SELECT column_name FROM (DESC (DESC SELECT * FROM test_table));
----
column_name
column_type
null
key
default
extra

# Test DESC ALL (show all tables)
statement ok
DESC ALL

# Test DESC without arguments (equivalent to DESC ALL)
statement ok
DESC

# Cleanup
statement ok
DROP TABLE test_table;

statement ok
DROP TABLE test_schema.another_table;

statement ok
DROP SCHEMA test_schema;

statement ok
DROP DATABASE test_db;
