# name: test/sql/json/scalar/test_json_extract_caching.test
# description: Verify document caching correctness for edge cases
# group: [scalar]

require json

# Test that cache correctly handles different JSON documents
statement ok
CREATE TABLE cache_test AS SELECT * FROM (VALUES
    (1, '{"a": 1, "b": 2}'::JSON),
    (2, '{"a": 3, "b": 4}'::JSON),
    (3, '{"a": 5, "b": 6}'::JSON)
) t(id, json_col);

# Multiple extractions should get correct values for each row
query III
SELECT id, json_col->>'a' as a, json_col->>'b' as b
FROM cache_test
ORDER BY id;
----
1	1	2
2	3	4
3	5	6

# Test with nested JSON
statement ok
CREATE TABLE nested_cache_test AS SELECT * FROM (VALUES
    (1, '{"outer": {"inner": 1}}'::JSON),
    (2, '{"outer": {"inner": 2}}'::JSON),
    (3, '{"outer": {"inner": 3}}'::JSON)
) t(id, json_col);

query II
SELECT id, json_col->'outer'->>'inner' as inner_val
FROM nested_cache_test
ORDER BY id;
----
1	1
2	2
3	3

# Test cache with NULL values
statement ok
CREATE TABLE null_cache_test AS SELECT * FROM (VALUES
    (1, '{"a": null}'::JSON),
    (2, '{"a": 1}'::JSON),
    (3, NULL::JSON)
) t(id, json_col);

query II
SELECT id, json_col->>'a' as a
FROM null_cache_test
ORDER BY id;
----
1	NULL
2	1
3	NULL

# Cleanup
statement ok
DROP TABLE cache_test;

statement ok
DROP TABLE nested_cache_test;

statement ok
DROP TABLE null_cache_test;
